{
  "datasets": [
    {
      "name": "6635a169",
      "displayName": "q1_total_tweets",
      "queryLines": [
        "SELECT COUNT(*) AS total_tweets\n",
        "FROM workspace.default.tweets_bronze"
      ]
    },
    {
      "name": "f483a69f",
      "displayName": "q2_tweets_with_mentions",
      "queryLines": [
        "SELECT COUNT(DISTINCT text) AS tweets_with_mentions\n",
        "FROM workspace.default.tweets_silver\n",
        "WHERE mention IS NOT NULL"
      ]
    },
    {
      "name": "b0dd8f47",
      "displayName": "q3_tweets_without_mentions",
      "queryLines": [
        "SELECT COUNT(DISTINCT text) AS tweets_without_mentions\n",
        "FROM workspace.default.tweets_silver\n",
        "WHERE mention IS NULL"
      ]
    },
    {
      "name": "b8e9c712",
      "displayName": "q4_top_tweeters",
      "queryLines": [
        "SELECT user, COUNT(*) AS tweet_count\n",
        "FROM workspace.default.tweets_bronze\n",
        "GROUP BY user\n",
        "ORDER BY tweet_count DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "f530a937",
      "displayName": "q5_top_positive",
      "queryLines": [
        "SELECT\n",
        "    mention,\n",
        "    (positive - negative) AS sentiment_power\n",
        "FROM workspace.default.gold_tweet_aggregations\n",
        "WHERE positive > negative\n",
        "ORDER BY sentiment_power DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "80ea5b15",
      "displayName": "q6_top_negative",
      "queryLines": [
        "SELECT\n",
        "    mention,\n",
        "    (negative - positive) AS sentiment_power\n",
        "FROM workspace.default.gold_tweet_aggregations\n",
        "WHERE negative > positive\n",
        "ORDER BY sentiment_power DESC\n",
        "LIMIT 20"
      ]
    }
  ],
